# Raitha Vikas AI - Environment Configuration Example
# Copy this file to .env and configure your secret credentials.
# NEVER commit the actual .env file with secrets to source control.

# Google Gemini AI API Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Backend Server Configuration
PORT=3001
NODE_ENV=production

# Automatic Failover Model: NVIDIA Nemotron 3 Ultra (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# ESP32 Hardware Base URL (Leave blank for Demo Mode or configure your ESP32's local IP)
# Example: http://192.168.1.145
ESP32_BASE_URL=

# Frontend Vite ESP32 Override (optional)
VITE_ESP32_BASE_URL=
